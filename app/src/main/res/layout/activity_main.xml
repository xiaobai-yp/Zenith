<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_root_liquid"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Zenith Thermal"
            android:textColor="@color/text"
            android:textSize="27sp"
            android:textStyle="normal"
            android:fontFamily="sans" />
        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_more"
            android:contentDescription="Menu"
            android:tint="@color/text"
            android:padding="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:paddingLeft="13dp"
        android:paddingRight="13dp">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            android:tint="@color/muted"
            android:contentDescription="Search" />
        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Search"
            android:textColorHint="@color/muted"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:singleLine="true"
            android:paddingLeft="10dp"
            android:paddingRight="4dp"
            android:inputType="text" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            layout="@layout/benchmark_page"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <ListView
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="7dp"
            android:clipToPadding="false"
            android:paddingTop="0dp"
            android:paddingBottom="94dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="true"
            android:scrollbarStyle="insideOverlay" />

        <ScrollView
            android:id="@+id/batteryPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="88dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="18dp">

                <!-- Status Monitor -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="18dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_row">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status Monitor"
                        android:textColor="@color/text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/batteryStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Displays real-time battery statistics (Temperature, Current mA, Deep Sleep) in the notification panel."
                        android:textColor="@color/muted"
                        android:textSize="14sp"
                        android:lineSpacingExtra="2dp" />

                    <TextView
                        android:id="@+id/batteryToggle"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="TURN OFF MONITOR"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="18dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_row">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Display"
                        android:textColor="@color/text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Battery Temperature Unit"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/temperatureUnit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Celsius (°C)  ▾"
                            android:textColor="@color/accent"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:layout_marginTop="8dp"
                        android:text="Voltage and power accuracy depends on your device kernel. Values are real-time."
                        android:textColor="@color/muted"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp" />
                </LinearLayout>

                <!-- Reset -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:padding="18dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_row">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reset"
                        android:textColor="@color/text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reset the stats when the battery reaches at or above a certain percentage"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <Switch
                            android:id="@+id/resetTargetSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:paddingEnd="8dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Battery percentage for stats reset"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/resetTargetValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="44dp"
                            android:gravity="center"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="100%"
                            android:textColor="@color/text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_profile_default" />
                    </LinearLayout>

                    <com.zenith.thermal.BatteryTargetSlider
                        android:id="@+id/resetTargetSeek"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="0dp"
                        android:contentDescription="Battery reset target slider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reset the stats when the device is plugged in"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <Switch
                            android:id="@+id/resetPluggedSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reset the stats when the device reboots or shuts down"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <Switch
                            android:id="@+id/resetRestartSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Notify me if idle drain is higher than a certain percentage"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <Switch
                            android:id="@+id/idleWarningSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:paddingEnd="8dp"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Idle drain percentage warning"
                            android:textColor="@color/text"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/idleWarningValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="44dp"
                            android:gravity="center"
                            android:paddingLeft="6dp"
                            android:paddingRight="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="5%"
                            android:textColor="@color/text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/bg_profile_default" />
                    </LinearLayout>

                    <com.zenith.thermal.BatteryTargetSlider
                        android:id="@+id/idleWarningSeek"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="0dp"
                        android:contentDescription="Idle drain warning threshold slider" />

                    <TextView
                        android:id="@+id/resetStatsButton"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="RESET STATS"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Touch-safe in-activity bottom navigation overlay. Only the actual
             navigation controls are clickable; the rest of the content remains touchable. -->
        <FrameLayout
            android:id="@+id/bottomBarHost"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:gravity="bottom|center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:background="@android:color/transparent" />

    </FrameLayout>
</LinearLayout>
