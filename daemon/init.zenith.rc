# init.zenith.rc — Android init service definition for zenithd.
# Place in /system/etc/init/ on the device.
#
# Copyright (c) 2026 ZenithThermal Contributors
# SPDX-License-Identifier: MIT

service zenithd /system/bin/zenithd
    class late_start
    user root
    group root system readproc
    capabilities SYS_NICE DAC_OVERRIDE
    socket zenithd stream 0660 root system
    disabled
    oneshot

on boot
    chmod 0666 /sys/class/thermal/thermal_message/sconfig

    # --- CPU 0 ---
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq
    # --- CPU 4 ---
    chmod 0664 /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpu4/cpufreq/scaling_min_freq
    # --- CPU 7 ---
    chmod 0664 /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq
    chmod 0664 /sys/devices/system/cpu/cpu7/cpufreq/scaling_min_freq
    # --- GPU ---
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/governor
    chmod 0664 /sys/class/kgsl/kgsl-3d0/max_clock_mhz
    chmod 0664 /sys/class/kgsl/kgsl-3d0/devfreq/min_freq

    # --- Scheduler ---
    chmod 0664 /sys/block/sda/queue/scheduler
    chmod 0664 /sys/block/sdb/queue/scheduler
    chmod 0664 /sys/block/sdc/queue/scheduler
    chmod 0664 /sys/block/sdd/queue/scheduler
    chmod 0664 /sys/block/sde/queue/scheduler
    chmod 0664 /sys/block/sdf/queue/scheduler
    chmod 0664 /sys/block/sdg/queue/scheduler
    chmod 0664 /sys/block/sdh/queue/scheduler
    chmod 0664 /sys/class/block/mmcblk0/queue/scheduler
    chmod 0664 /sys/class/block/mmcblk1/queue/scheduler

    # --- Rate limits ---
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/schedutil/rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/schedutil/rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy0/vorpal/rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy4/vorpal/rate_limit_us
    chmod 0664 /sys/devices/system/cpu/cpufreq/policy7/vorpal/rate_limit_us
    chmod 0664 /sys/class/kgsl/kgsl-3d0/default_pwrlevel

# --- DEFAULT (profile 0) ---
on property:persist.sys.zenith.thermal=0
    write /sys/class/thermal/thermal_message/sconfig 0
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 633000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 787000
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 2419200
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 2841600
    write /sys/class/kgsl/kgsl-3d0/max_clock_mhz 592
    write /proc/sys/kernel/sched_bore 0
    write /proc/sys/net/ipv4/tcp_congestion_control westwood
    write /sys/block/sda/queue/scheduler bfq
    write /sys/block/sdb/queue/scheduler bfq
    write /sys/block/sdc/queue/scheduler bfq
    write /sys/block/sdd/queue/scheduler bfq
    write /sys/block/sde/queue/scheduler bfq
    write /sys/block/sdf/queue/scheduler bfq
    write /sys/block/sdg/queue/scheduler bfq
    write /sys/block/sdh/queue/scheduler bfq
    write /sys/class/block/mmcblk0/queue/scheduler bfq
    write /sys/class/block/mmcblk1/queue/scheduler bfq
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy4/schedutil/rate_limit_us 3000
    write /sys/devices/system/cpu/cpufreq/policy7/schedutil/rate_limit_us 5000
    write /sys/class/kgsl/kgsl-3d0/default_pwrlevel 3

# --- POWERSAVE (profile 2) ---
on property:persist.sys.zenith.thermal=2
    write /sys/class/thermal/thermal_message/sconfig 2
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor powersave
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor powersave
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor powersave
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 710000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 844000
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_max_freq 1075200
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_max_freq 1344000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_max_freq 1862400

# --- IN-CALLS (profile 8) ---
on property:persist.sys.zenith.thermal=8
    write /sys/class/thermal/thermal_message/sconfig 8
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor schedutil
    write /proc/sys/kernel/sched_bore 0
    write /proc/sys/net/ipv4/tcp_congestion_control westwood
    write /sys/block/sda/queue/scheduler bfq
    write /sys/block/sdb/queue/scheduler bfq
    write /sys/block/sdc/queue/scheduler bfq
    write /sys/block/sdd/queue/scheduler bfq
    write /sys/block/sde/queue/scheduler bfq
    write /sys/block/sdf/queue/scheduler bfq
    write /sys/block/sdg/queue/scheduler bfq
    write /sys/block/sdh/queue/scheduler bfq
    write /sys/class/block/mmcblk0/queue/scheduler bfq
    write /sys/class/block/mmcblk1/queue/scheduler bfq
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 633000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 787000

# --- GAME (profile 9) ---
on property:persist.sys.zenith.thermal=9
    write /sys/class/thermal/thermal_message/sconfig 9
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_max_freq 2419200
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_max_freq 3187200
    write /sys/class/kgsl/kgsl-3d0/max_clock_mhz 592
    write /sys/devices/system/cpu/cpu7/cpufreq/vorpal/gaming_mode 1
    write /sys/block/sda/queue/scheduler ssg
    write /sys/block/sdb/queue/scheduler ssg
    write /sys/block/sdc/queue/scheduler ssg
    write /sys/block/sdd/queue/scheduler ssg
    write /sys/block/sde/queue/scheduler ssg
    write /sys/block/sdf/queue/scheduler ssg
    write /sys/block/sdg/queue/scheduler ssg
    write /sys/block/sdh/queue/scheduler ssg
    write /sys/class/block/mmcblk0/queue/scheduler ssg
    write /sys/class/block/mmcblk1/queue/scheduler ssg
    write /proc/sys/kernel/sched_bore 1
    write /proc/sys/net/ipv4/tcp_congestion_control bbrplus
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 633000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 787000
    write /sys/devices/system/cpu/cpufreq/policy0/vorpal/rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy4/vorpal/rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy7/vorpal/rate_limit_us 2000
    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 0

# --- DYNAMIC (profile 10) ---
on property:persist.sys.zenith.thermal=10
    write /sys/class/thermal/thermal_message/sconfig 10
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_max_freq 2419200
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_max_freq 2841600
    write /sys/class/kgsl/kgsl-3d0/max_clock_mhz 592
    write /sys/devices/system/cpu/cpu7/cpufreq/vorpal/gaming_mode 1
    write /sys/block/sda/queue/scheduler ssg
    write /sys/block/sdb/queue/scheduler ssg
    write /sys/block/sdc/queue/scheduler ssg
    write /sys/block/sdd/queue/scheduler ssg
    write /sys/block/sde/queue/scheduler ssg
    write /sys/block/sdf/queue/scheduler ssg
    write /sys/block/sdg/queue/scheduler ssg
    write /sys/block/sdh/queue/scheduler ssg
    write /sys/class/block/mmcblk0/queue/scheduler ssg
    write /sys/class/block/mmcblk1/queue/scheduler ssg
    write /proc/sys/kernel/sched_bore 1
    write /proc/sys/net/ipv4/tcp_congestion_control bbrplus
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 633000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 787000
    write /sys/devices/system/cpu/cpufreq/policy0/vorpal/rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy4/vorpal/rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy7/vorpal/rate_limit_us 2000
    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 0

# --- CLASS 0 (profile 11) ---
on property:persist.sys.zenith.thermal=11
    write /sys/class/thermal/thermal_message/sconfig 11
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor schedutil
    write /proc/sys/kernel/sched_bore 0
    write /proc/sys/net/ipv4/tcp_congestion_control westwood
    write /sys/block/sda/queue/scheduler bfq
    write /sys/block/sdb/queue/scheduler bfq
    write /sys/block/sdc/queue/scheduler bfq
    write /sys/block/sdd/queue/scheduler bfq
    write /sys/block/sde/queue/scheduler bfq
    write /sys/block/sdf/queue/scheduler bfq
    write /sys/block/sdg/queue/scheduler bfq
    write /sys/block/sdh/queue/scheduler bfq
    write /sys/class/block/mmcblk0/queue/scheduler bfq
    write /sys/class/block/mmcblk1/queue/scheduler bfq
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 633000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 787000

# --- CAMERA (profile 12) ---
on property:persist.sys.zenith.thermal=12
    write /sys/class/thermal/thermal_message/sconfig 12
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor schedutil
    write /proc/sys/kernel/sched_bore 0
    write /proc/sys/net/ipv4/tcp_congestion_control westwood
    write /sys/block/sda/queue/scheduler bfq
    write /sys/block/sdb/queue/scheduler bfq
    write /sys/block/sdc/queue/scheduler bfq
    write /sys/block/sdd/queue/scheduler bfq
    write /sys/block/sde/queue/scheduler bfq
    write /sys/block/sdf/queue/scheduler bfq
    write /sys/block/sdg/queue/scheduler bfq
    write /sys/block/sdh/queue/scheduler bfq
    write /sys/class/block/mmcblk0/queue/scheduler bfq
    write /sys/class/block/mmcblk1/queue/scheduler bfq
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 633000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 787000

# --- PUBG (profile 13) ---
on property:persist.sys.zenith.thermal=13
    write /sys/class/thermal/thermal_message/sconfig 13
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_max_freq 2419200
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_max_freq 3187200
    write /sys/class/kgsl/kgsl-3d0/max_clock_mhz 592
    write /sys/devices/system/cpu/cpu7/cpufreq/vorpal/gaming_mode 1
    write /sys/block/sda/queue/scheduler ssg
    write /sys/block/sdb/queue/scheduler ssg
    write /sys/block/sdc/queue/scheduler ssg
    write /sys/block/sdd/queue/scheduler ssg
    write /sys/block/sde/queue/scheduler ssg
    write /sys/block/sdf/queue/scheduler ssg
    write /sys/block/sdg/queue/scheduler ssg
    write /sys/block/sdh/queue/scheduler ssg
    write /sys/class/block/mmcblk0/queue/scheduler ssg
    write /sys/class/block/mmcblk1/queue/scheduler ssg
    write /proc/sys/kernel/sched_bore 1
    write /proc/sys/net/ipv4/tcp_congestion_control bbrplus
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 633000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 787000
    write /sys/devices/system/cpu/cpufreq/policy0/vorpal/rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy4/vorpal/rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy7/vorpal/rate_limit_us 2000
    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 0

# --- YOUTUBE (profile 14) ---
on property:persist.sys.zenith.thermal=14
    write /sys/class/thermal/thermal_message/sconfig 14
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor schedutil
    write /proc/sys/kernel/sched_bore 0
    write /proc/sys/net/ipv4/tcp_congestion_control westwood
    write /sys/block/sda/queue/scheduler bfq
    write /sys/block/sdb/queue/scheduler bfq
    write /sys/block/sdc/queue/scheduler bfq
    write /sys/block/sdd/queue/scheduler bfq
    write /sys/block/sde/queue/scheduler bfq
    write /sys/block/sdf/queue/scheduler bfq
    write /sys/block/sdg/queue/scheduler bfq
    write /sys/block/sdh/queue/scheduler bfq
    write /sys/class/block/mmcblk0/queue/scheduler bfq
    write /sys/class/block/mmcblk1/queue/scheduler bfq
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 633000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 787000

# --- AR & VR (profile 15) ---
on property:persist.sys.zenith.thermal=15
    write /sys/class/thermal/thermal_message/sconfig 15
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor schedutil
    write /proc/sys/kernel/sched_bore 0
    write /proc/sys/net/ipv4/tcp_congestion_control westwood
    write /sys/block/sda/queue/scheduler bfq
    write /sys/block/sdb/queue/scheduler bfq
    write /sys/block/sdc/queue/scheduler bfq
    write /sys/block/sdd/queue/scheduler bfq
    write /sys/block/sde/queue/scheduler bfq
    write /sys/block/sdf/queue/scheduler bfq
    write /sys/block/sdg/queue/scheduler bfq
    write /sys/block/sdh/queue/scheduler bfq
    write /sys/class/block/mmcblk0/queue/scheduler bfq
    write /sys/class/block/mmcblk1/queue/scheduler bfq
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 633000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 787000

# --- GAME 2 (profile 16) ---
on property:persist.sys.zenith.thermal=16
    write /sys/class/thermal/thermal_message/sconfig 16
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor vorpal
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 1804800
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_max_freq 2246400
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_max_freq 2745600
    write /sys/class/kgsl/kgsl-3d0/max_clock_mhz 592
    write /sys/devices/system/cpu/cpu7/cpufreq/vorpal/gaming_mode 1
    write /sys/block/sda/queue/scheduler ssg
    write /sys/block/sdb/queue/scheduler ssg
    write /sys/block/sdc/queue/scheduler ssg
    write /sys/block/sdd/queue/scheduler ssg
    write /sys/block/sde/queue/scheduler ssg
    write /sys/block/sdf/queue/scheduler ssg
    write /sys/block/sdg/queue/scheduler ssg
    write /sys/block/sdh/queue/scheduler ssg
    write /sys/class/block/mmcblk0/queue/scheduler ssg
    write /sys/class/block/mmcblk1/queue/scheduler ssg
    write /proc/sys/kernel/sched_bore 1
    write /proc/sys/net/ipv4/tcp_congestion_control bbrplus
    write /sys/devices/system/cpu/policy0/cpufreq/scaling_min_freq 300000
    write /sys/devices/system/cpu/cpufreq/policy4/scaling_min_freq 633000
    write /sys/devices/system/cpu/cpufreq/policy7/scaling_min_freq 787000
    write /sys/devices/system/cpu/cpufreq/policy0/vorpal/rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy4/vorpal/rate_limit_us 2000
    write /sys/devices/system/cpu/cpufreq/policy7/vorpal/rate_limit_us 2000
    write /sys/class/kgsl/kgsl-3d0/max_pwrlevel 0

# --- Start daemon when thermal property is set ---
on property:persist.sys.zenith.thermal=*
    start zenithd
